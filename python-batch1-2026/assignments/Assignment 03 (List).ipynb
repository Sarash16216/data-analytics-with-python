   "source": [
    "# Accept inputs separated by space and convert to a list\n",
    "items = input(\"Enter list elements separated by space: \").split()\n",
    "\n",
    "# Slicing with step 2 gets alternate elements\n",
    "alternate_items = items[::2]\n",
    "\n",
    "print(\"Alternate elements:\", alternate_items)"
   ]
  }
